{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ralucapaduraru.ro" }],
      "destination": "https://www.ralucapaduraru.ro/:path*",
      "permanent": true
    },
    { "source": "/index.html",    "destination": "/",                                    "permanent": true },
    { "source": "/subscribe",     "destination": "https://ralucapaduraru.substack.com/", "permanent": true },
    { "source": "/media",         "destination": "/about.html",  "permanent": true },
    { "source": "/download",      "destination": "/frameworks/", "permanent": true },
    { "source": "/ai-canvas.pdf", "destination": "/",            "permanent": true },
    { "source": "/api",           "destination": "/",            "permanent": true },
    { "source": "/resources/state-of-ai-romania",       "destination": "/romanian-state-of-ai/", "permanent": true },
    { "source": "/resources/state-of-ai-romania/:path*", "destination": "/romanian-state-of-ai/", "permanent": true },
    { "source": "/state-of-ai.pdf", "destination": "/romanian-state-of-ai/", "permanent": true },
    { "source": "/summer-mentoring",      "destination": "/mentorat-ai", "permanent": true },
    { "source": "/summer-mentoring.html", "destination": "/mentorat-ai", "permanent": true }
  ],
  "rewrites": [
    { "source": "/viitoruri", "destination": "/viitoruri.html" },
    { "source": "/contact",   "destination": "/contact.html"   },
    { "source": "/mentorat-ai", "destination": "/mentorat-ai.html" },
    { "source": "/build-your-cortex", "destination": "/build-your-cortex.html" },
    { "source": "/feedback-materiale", "destination": "/feedback-materiale.html" },
    { "source": "/people-architects", "destination": "/people-architects.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/downloads/30-cifre-ai-munca.pdf",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/cortex/skills/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
